# ==============================
# APPLICATION
# ==============================

SERVICE_NAME=transaction-history-service
APP_ENV=local
LOG_LEVEL=debug

# ==============================
# DATABASE
# ==============================

DB_LIST=transaction_history

DB_TRANSACTION_HISTORY_DRIVER=sqlserver
DB_TRANSACTION_HISTORY_HOST=localhost
DB_TRANSACTION_HISTORY_PORT=1433
DB_TRANSACTION_HISTORY_NAME=transaction_history
DB_TRANSACTION_HISTORY_USER=sa
DB_TRANSACTION_HISTORY_PASSWORD=YourStrong!Passw0rd
DB_TRANSACTION_HISTORY_PARAMS=

# ==============================
# TRANSPORT
# ==============================

GRPC_PORT=9090
HTTP_PORT=8080
HTTP_PPROF_ENABLED=false

# ==============================
# OBSERVABILITY
# ==============================

APM_ENDPOINT=
METRICS_ENABLED=false
DIAG_ENABLED=true

# ==============================
# SIGNATURE (FRONTEND VALIDATION)
# ==============================

# A non-empty master key enables signature validation.
AUTH_SIGNATURE_MASTER_KEY=

# ==============================
# KAFKA INBOUND
# ==============================

# Setting KAFKA_BROKERS enables Kafka.
# KAFKA_BROKERS=
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
KAFKA_INBOUND_ENABLED=false
HISTORY_STATUS_TOPIC=sample.transaction.status
HISTORY_ALLOWED_SOURCES=sample-producer
HISTORY_ALLOWED_APPS=app_a,app_b
# Hex-encoded secret; at least 32 bytes before hex encoding.
HISTORY_HASH_KEY=
HISTORY_BACKOFFICE_ROLE=backoffice
