{
  "info": {
    "name": "Transaction History Service API",
    "description": "Authenticated customer history endpoints. Backoffice search is gRPC-only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "List Transactions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/transactions?pageSize=20",
          "host": ["{{base_url}}"],
          "path": ["v1", "transactions"],
          "query": [
            { "key": "startDate", "value": "2026-10-01", "disabled": true },
            { "key": "endDate", "value": "2026-10-16", "disabled": true },
            { "key": "productCategory", "value": "transfer", "disabled": true },
            { "key": "productType", "value": "transfer_internal", "disabled": true },
            { "key": "status", "value": "SUCCESS", "disabled": true },
            { "key": "cursor", "value": "", "disabled": true },
            { "key": "pageSize", "value": "20" }
          ]
        }
      },
      "response": [
        {
          "name": "200 success",
          "originalRequest": { "method": "GET", "url": "{{base_url}}/v1/transactions?pageSize=20" },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"status\": \"SUCCESS\",\n  \"response_code\": \"CORE-0000\",\n  \"message\": \"success\",\n  \"request_id\": \"req-sample-01\",\n  \"timestamp\": \"2026-10-16T12:00:00Z\",\n  \"data\": {\n    \"items\": [{\n      \"transactionId\": \"tx-sample-001\",\n      \"productCategory\": \"transfer\",\n      \"productType\": \"transfer_internal\",\n      \"provider\": \"bca\",\n      \"providerName\": \"BCA\",\n      \"direction\": \"debit\",\n      \"amount\": \"125000.00\",\n      \"feeAmount\": \"2500.00\",\n      \"totalAmount\": \"127500.00\",\n      \"currency\": \"IDR\",\n      \"status\": \"SUCCESS\",\n      \"statusLabel\": \"Berhasil\",\n      \"destinationNoMasked\": \"****4321\",\n      \"transactionAt\": \"2026-10-16T04:30:00Z\"\n    }],\n    \"nextCursor\": \"\"\n  }\n}"
        },
        {
          "name": "401 authentication required",
          "status": "Unauthorized",
          "code": 401,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"status\": \"FAILED\",\n  \"response_code\": \"CORE-1001\",\n  \"message\": \"Sesi Anda telah berakhir. Silakan masuk kembali.\",\n  \"request_id\": \"req-sample-02\",\n  \"timestamp\": \"2026-10-16T12:00:00Z\"\n}"
        }
      ]
    },
    {
      "name": "Get Transaction",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/transactions/:transaction_id",
          "host": ["{{base_url}}"],
          "path": ["v1", "transactions", ":transaction_id"],
          "variable": [{ "key": "transaction_id", "value": "tx-sample-001" }]
        }
      },
      "response": [
        {
          "name": "200 success",
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"status\": \"SUCCESS\",\n  \"response_code\": \"CORE-0000\",\n  \"message\": \"success\",\n  \"request_id\": \"req-sample-03\",\n  \"timestamp\": \"2026-10-16T12:00:00Z\",\n  \"data\": {\n    \"transaction\": {\n      \"transactionId\": \"tx-sample-001\",\n      \"productCategory\": \"transfer\",\n      \"productType\": \"transfer_internal\",\n      \"provider\": \"bca\",\n      \"providerName\": \"BCA\",\n      \"direction\": \"debit\",\n      \"amount\": \"125000.00\",\n      \"feeAmount\": \"2500.00\",\n      \"totalAmount\": \"127500.00\",\n      \"currency\": \"IDR\",\n      \"status\": \"SUCCESS\",\n      \"statusLabel\": \"Berhasil\",\n      \"destinationNoMasked\": \"****4321\",\n      \"transactionAt\": \"2026-10-16T04:30:00Z\",\n      \"statusHistory\": [{\"toStatus\":\"SUCCESS\",\"statusLabel\":\"Berhasil\",\"changedAt\":\"2026-10-16T04:30:03Z\"}],\n      \"transfer\": {\"bankCode\":\"014\",\"note\":\"Sample transfer\"}\n    }\n  }\n}"
        },
        {
          "name": "404 not found for this owner",
          "status": "Not Found",
          "code": 404,
          "_postman_previewlanguage": "json",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "body": "{\n  \"status\": \"FAILED\",\n  \"response_code\": \"CORE-1004\",\n  \"message\": \"Riwayat transaksi tidak ditemukan.\",\n  \"request_id\": \"req-sample-04\",\n  \"timestamp\": \"2026-10-16T12:00:00Z\"\n}"
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" }
  ]
}
